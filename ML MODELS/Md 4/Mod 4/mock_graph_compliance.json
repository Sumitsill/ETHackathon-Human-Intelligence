    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Section 21",
        "obligation_text": "Every moving part of dangerous machinery, including every shaft, wheel, or pinion, shall be securely fenced by safeguards of substantial construction.",
        "numeric_threshold": "N/A",
        "id": "REQ-FAC-21",
        "created_at": "2026-07-20 20:03:03.723818"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Section 38",
        "obligation_text": "Precautions in case of fire. All factories shall be provided with effective means of escape and fire extinguishing equipment. Fire safety training must be verified.",
        "numeric_threshold": "N/A",
        "id": "REQ-FAC-38",
        "created_at": "2026-07-20 20:03:03.804822"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Rule 105",
        "obligation_text": "No electrical wiring or apparatus shall be used in hazardous locations unless certified Flameproof (FLP) or Intrinsically Safe (IS) by PESO.",
        "numeric_threshold": "N/A",
        "id": "REQ-PESO-105",
        "created_at": "2026-07-20 20:03:03.890056"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Rule 122",
        "obligation_text": "All pressure vessels in service shall be fitted with safety valves that must be tested and certified by a competent person at least once in a year.",
        "numeric_threshold": "N/A",
        "id": "REQ-PESO-122",
        "created_at": "2026-07-20 20:03:03.932284"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Section 4.1",
        "obligation_text": "A written Permit to Work (PTW) must be issued before commencing any hot work, welding, cutting or cold work on hydrocarbon processing equipment.",
        "numeric_threshold": "N/A",
        "id": "REQ-OISD-105-WORK",
        "created_at": "2026-07-20 20:03:03.972595"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Effluent pH",
        "obligation_text": "Effluent discharge pH must be maintained strictly between 5.5 and 9.0.",
        "numeric_threshold": "{\"parameter\": \"ph\", \"operator\": \"between\", \"value\": [5.5, 9.0], \"unit\": \"pH\"}",
        "id": "REQ-CPCB-PH",
        "created_at": "2026-07-20 20:03:04.076160"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Effluent BOD",
        "obligation_text": "Effluent biochemical oxygen demand (BOD) must not exceed 30 mg/l.",
        "numeric_threshold": "{\"parameter\": \"bod\", \"operator\": \"<=\", \"value\": 30.0, \"unit\": \"mg/l\"}",
        "id": "REQ-CPCB-BOD",
        "created_at": "2026-07-20 20:03:04.120923"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Effluent COD",
        "obligation_text": "Effluent chemical oxygen demand (COD) must not exceed 250 mg/l.",
        "numeric_threshold": "{\"parameter\": \"cod\", \"operator\": \"<=\", \"value\": 250.0, \"unit\": \"mg/l\"}",
        "id": "REQ-CPCB-COD",
        "created_at": "2026-07-20 20:03:04.167576"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Emission SO2",
        "obligation_text": "Flue gas sulfur dioxide (SO2) emission from stacks must not exceed 50 mg/Nm3.",
        "numeric_threshold": "{\"parameter\": \"so2\", \"operator\": \"<=\", \"value\": 50.0, \"unit\": \"mg/Nm3\"}",
        "id": "REQ-CPCB-SO2",
        "created_at": "2026-07-20 20:03:04.214121"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "Emission NOx",
        "obligation_text": "Flue gas nitrogen oxides (NOx) emission from stacks must not exceed 300 mg/Nm3.",
        "numeric_threshold": "{\"parameter\": \"nox\", \"operator\": \"<=\", \"value\": 300.0, \"unit\": \"mg/Nm3\"}",
        "id": "REQ-CPCB-NOX",
        "created_at": "2026-07-20 20:03:04.256191"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "OISD-105-3.2",
        "obligation_text": "Pressure vessels shall undergo internal inspection at least once every 5 years or as per statutory requirement.",
        "numeric_threshold": "N/A",
        "id": "OISD-105-3.2",
        "created_at": "2026-07-20 20:03:04.304522"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "PESO-CCE-12",
        "obligation_text": "Storage tanks handling flammable liquids shall have functional relief valves tested annually.",
        "numeric_threshold": "N/A",
        "id": "PESO-CCE-12",
        "created_at": "2026-07-20 20:03:04.342505"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "FactoriesAct-Sec-28",
        "obligation_text": "All hoists, lifts and pressure plants shall be periodically examined by a competent person.",
        "numeric_threshold": "N/A",
        "id": "FactoriesAct-Sec-28",
        "created_at": "2026-07-20 20:03:04.379284"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "clause_id": "OISD-222-4.1",
